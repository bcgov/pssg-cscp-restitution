{
  "name": "restitution_app",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.config.js",
    "build": "ng build",
    "builduat": "ng build --configuration production --base-href /uat/restwebforms/ --deploy-url /uat/restwebforms/",
    "buildprod": "ng build --configuration=production",
    "watch": "ng build --watch --base-href /restwebforms/ --deploy-url /restwebforms/",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --loglevel=warn --check \"./src/**/*.{js,jsx,ts,tsx,css,scss}\"",
    "format-fix": "prettier --loglevel=warn --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "generate:api": "orval --config orval.config.ts",
    "e2e": "playwright test --project=localhost",
    "e2e:dev": "playwright test --project=dev",
    "e2e:test": "playwright test --project=test",
    "e2e:test:headed": "playwright test --project=test --headed",
    "e2e:test:ui": "playwright test --project=test --ui",
    "e2e:report": "playwright show-report"
  },
  "private": true,
  "dependencies": {
    "@almothafar/angular-signature-pad": "^10.0.0",
    "@angular/animations": "22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/material-moment-adapter": "^22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/platform-browser-dynamic": "22.3.0",
    "@angular/platform-server": "22.3.0",
    "@angular/router": "22.3.0",
    "@ngrx/signals": "^22.0.1",
    "bootstrap": "^5.3.9",
    "moment": "^2.22.2",
    "mygovbc-bootstrap-theme": "^0.4.1",
    "ngx-bootstrap": "^22.0.0",
    "ngx-file-drop": "^16.0.0",
    "ngx-mask": "^22.3.1",
    "ngx-spinner": "^22.0.1",
    "rxjs": "^7.8.2",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/language-service": "^22.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "jsdom": "^31.0.1",
    "orval": "^8.49.0",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-node": "~7.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1",
    "webpack": "^5.113.0"
  }
}
